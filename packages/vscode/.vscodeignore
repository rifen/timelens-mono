# Exclude everything by default
*

# Essential extension metadata files
!package.json
!README.md
!CHANGELOG.md
!LICENSE

# Compiled extension output
!dist/**

# Source TypeScript files (optional, keep if needed for debugging)
!src/**/*.ts

# Only include the core runtime dependency
!node_modules/@rifen/timescope-core/dist/**
!node_modules/@rifen/timescope-core/package.json