# Exclude source maps
*.map
*.ts.map

# Exclude test files
test/
src/test/
**/*.test.ts

# Exclude development files
.mocharc.json
tsconfig.json
.eslintignore
eslintrc.json

# Exclude documentation except README
!README.md
!CHANGELOG.md
!LICENSE

# Include dist
!dist/**/*

# Exclude everything else
*
!node_modules/
!node_modules/**


# .github
docs
# **/node_modules/**
!dist/**/*.js
!dist/**/*.d.ts
!node_modules/@rifen/timescope-core/**

# Exclude monorepo sibling packages (commented out to include core)
# ../../packages/core/**
# ../../packages/nvim/**

# Exclude monorepo root (commented out to include core)




# Only include what's needed
!package.json
!README.md
!CHANGELOG.md
!LICENSE
!dist/**
!src/**/*.ts