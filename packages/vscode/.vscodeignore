# Exclude everything by default
*

# Essential extension metadata files
!package.json
!README.md
!CHANGELOG.md
!LICENSE

# Compiled extension output (including bundled core)
!dist/**
# Explicitly include node_modules inside dist (VS Code defaults exclude node_modules)
!dist/node_modules/**

# Source TypeScript files (optional, keep if needed for debugging)
!src/**/*.ts

# Include the extension icon
!extension/timescope.ico