# Exclude source maps
*.map
*.ts.map

# Exclude test files
test/
src/test/
**/*.test.ts

# Exclude development files
.mocharc.json
tsconfig.json
.eslintignore
eslintrc.json

# Exclude documentation except README
!README.md
!CHANGELOG.md
!LICENSE

# Include dist
!dist/**/*

# Exclude everything else
*
node_modules/**
.gitignore
.gitattributes
# .github
docs
**/node_modules/**
!dist/**/*.js
!dist/**/*.d.ts

# Exclude monorepo sibling packages
../../packages/core/**
../../packages/nvim/**

# Exclude monorepo root
../../.git/**
../../node_modules/**
../../pnpm-lock.yaml

# Only include what's needed
!package.json
!README.md
!CHANGELOG.md
!LICENSE
!dist/**
!src/**/*.ts